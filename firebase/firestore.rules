rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Students collection: authenticated users can read, only verified admin can write
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && (request.auth.token.email in ['admin@sekolahku.sch.id', 'ibnumaulidi08@gmail.com']);
    }

    // Settings (rombel & school profile): authenticated users can read, only verified admin can write
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.token.email in ['admin@sekolahku.sch.id', 'ibnumaulidi08@gmail.com']);
    }
  }
}
